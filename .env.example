# Linkprosoft Backend example environment variables
# Copy to `.env` and fill values before running locally

# App
NODE_ENV=development
PORT=5020

# Database
DATABASE_URL=postgres://username:password@localhost:5432/linkprosoft_dev

# JWT
JWT_SECRET=replace_with_strong_jwt_secret
ACCESS_TOKEN_EXPIRES_SECONDS=1800
# Refresh Token Configuration
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here

# Refresh token (longer lived)
REFRESH_TOKEN_SECRET=replace_with_strong_refresh_secret
REFRESH_TOKEN_EXPIRES_DAYS=7

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRES_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS={"login":5,"forgotPassword":3,"verifyOtp":10}

# Email Configuration (for OTP delivery)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email_username
EMAIL_PASS=your_email_password
EMAIL_FROM=noreply@linkprosoft.com
EMAIL_SECURE=false

# External OTP Configuration (to use Resend API for OTP delivery)
USE_EXTERNAL_OTP=false
RESEND_API_KEY=re_9JrXv21k_9htcQ58q8MLYLp6sBv2yiCNy
OTP_API_BASE_URL=http://localhost:5020   # optional, defaults to this if not set

# Paystack Payment Integration (Phase 4 MVP)
# Get these from Paystack Dashboard: https://dashboard.paystack.com/
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_from_paystack_here

# Google OAuth Configuration (Phase 4 MVP)
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5020/api/auth/google/callback

# OTP External Service (Resend)
# Set to "true" to use Resend for sending OTP emails (instead of nodemailer/ethereal)
USE_EXTERNAL_OTP=true
# Your Resend API key (required when USE_EXTERNAL_OTP=true)
RESEND_API_KEY=your_resend_api_key_here
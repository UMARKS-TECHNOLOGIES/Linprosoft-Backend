  "item": [
    {
      "name": "1. SIGNUP - Professional User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has correct structure', function () {",
              "    let jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('success', true);",
              "    pm.expect(jsonData).to.have.property('message');",
              "    pm.expect(jsonData).to.have.property('data');",
              "    pm.expect(jsonData).to.have.property('timestamp');",
              "});",
              "",
              "pm.test('User data contains no password', function () {",
              "    let jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.user).not.to.have.property('password');",
              "});",
              "",
              "pm.test('Token is set in cookie', function () {",
              "    pm.expect(pm.cookies.has('token')).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@test.com\",\n  \"password\": \"SecurePass123!\",\n  \"passwordConfirm\": \"SecurePass123!\",\n  \"userType\": \"professional\",\n  \"phone\": \"+1234567890\",\n  \"location\": \"New York\"\n}"
        },
        "url": {
          "raw": "http://localhost:5020/api/auth/signup",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5020",
          "path": ["api", "auth", "signup"]
        }
      },
      "response": []
    },

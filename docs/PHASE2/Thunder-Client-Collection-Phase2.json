{
  "info": {
    "name": "Linkprosoft Professional API - Phase 2 Testing",
    "description": "Complete test suite for Phase 2 professional profile, skills, certifications, portfolio, and search endpoints",
    "version": "2.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "baseURL": "http://localhost:5020"
  },
  "item": [
    {
      "name": "🔍 SETUP",
      "item": [
        {
          "name": "0. Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5020/api/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5020",
              "path": ["api", "health"]
            }
          }
        },
        {
          "name": "1. Signup Professional User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Has user data', function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.user).to.have.property('id');",
                  "});",
                  "let jsonData = pm.response.json();",
                  "pm.environment.set('token', pm.cookies.get('access_token'));",
                  "pm.environment.set('userId', jsonData.data.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\":\"John\",\"lastName\":\"Doe\",\"email\":\"john.doe@test.com\",\"password\":\"SecurePass123!\",\"passwordConfirm\":\"SecurePass123!\",\"userType\":\"professional\"}"
            },
            "url": {
              "raw": "http://localhost:5020/api/auth/signup",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5020",
              "path": ["api", "auth", "signup"]
            }
          }
        }
      ]
    },
